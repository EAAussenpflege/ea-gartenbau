# =========================================================
# EA-Außenpflege – Apache-Konfiguration für STRATO Webhosting
# Diese Datei landet beim Build automatisch in dist/ und muss
# mit auf den Webspace hochgeladen werden.
# =========================================================

# ---------------------------------------------------------
# HTTPS erzwingen
#
# WICHTIG: Erst aktivieren (die vier Zeilen entkommentieren),
# wenn das SSL-Zertifikat im STRATO-Kundenlogin aktiv ist und
# https://deine-domain.de im Browser bereits funktioniert.
# Vorher führt die Weiterleitung zu einer Fehlermeldung.
# ---------------------------------------------------------
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} !=on
#   RewriteCond %{HTTP:X-Forwarded-Proto} !https
#   RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
# </IfModule>

# ---------------------------------------------------------
# Eigene Fehlerseite (Astro erzeugt 404 erst, wenn eine
# src/pages/404.astro existiert – vorher auskommentiert lassen)
# ---------------------------------------------------------
# ErrorDocument 404 /404.html

# ---------------------------------------------------------
# Komprimierung – spart Ladezeit bei HTML, CSS und SVG
# ---------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------------------------------------------------------
# Browser-Caching
# Bilder und Fonts lange, HTML bewusst kurz, damit
# Textänderungen sofort bei den Besuchern ankommen.
# ---------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 6 months"
  ExpiresByType image/png                 "access plus 6 months"
  ExpiresByType image/webp                "access plus 6 months"
  ExpiresByType image/svg+xml             "access plus 6 months"
  ExpiresByType image/x-icon              "access plus 1 year"
</IfModule>

# ---------------------------------------------------------
# Zeichensatz und Sicherheits-Header
# ---------------------------------------------------------
AddDefaultCharset UTF-8

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Hinweis: "Options -Indexes" wurde entfernt. Viele Hoster erlauben die
# Options-Anweisung in der .htaccess nicht und antworten dann mit
# 500 Internal Server Error.
