---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Kontakt | EA-Außenpflege"
  description="Kontaktieren Sie EA-Außenpflege für ein kostenloses Angebot zu Garten- und Landschaftsbau, Gartenpflege oder Reinigungsleistungen. Antwort innerhalb von 24 Stunden."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Kontakt</span>
      <h1>Kontakt</h1>
      <p>Schreiben Sie uns – wir melden uns innerhalb von 24 Stunden zurück.</p>
    </div>
  </section>

  <section class="container page-body">
    <p class="notice"><span aria-hidden="true">🌱</span> Inhalt folgt</p>
  </section>
</BaseLayout>
