---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Unsere Dienstleistungen | EA-Außenpflege"
  description="Garten- und Landschaftsbau, Gartenpflege und Fassadenreinigung – alle Leistungen von EA-Außenpflege im Überblick."
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">Leistungen</span>
      <h1>Unsere Dienstleistungen</h1>
      <p>Alle Leistungen rund um Garten, Glas und Fassade im Detail.</p>
    </div>
  </section>

  <section class="container page-body">
    <p class="notice"><span aria-hidden="true">🌱</span> Inhalt folgt</p>
  </section>
</BaseLayout>
