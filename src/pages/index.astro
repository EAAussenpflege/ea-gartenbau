---
import BaseLayout from '../layouts/BaseLayout.astro';

const partners = [
  { src: '/images/logos/terrastein.svg', alt: 'TerraStein Naturstein' },
  { src: '/images/logos/floraplus.svg', alt: 'FloraPlus Baumschule' },
  { src: '/images/logos/gruenwerk.svg', alt: 'GrünWerk Maschinen' },
  { src: '/images/logos/hortitec.svg', alt: 'HortiTec Bewässerung' },
  { src: '/images/logos/stadtgruen.svg', alt: 'Stadtgrün Kommunal Service' },
];

const services = [
  {
    title: 'Garten- & Landschaftsbau',
    text: 'Von der Planung bis zur letzten Pflanze: Terrassen, Wege, Mauern, Zäune, Rollrasen und komplette Gartenneuanlagen.',
    image: '/images/leistung-galabau.jpg',
    tags: ['Terrassen & Wege', 'Pflasterarbeiten', 'Neuanlage'],
    featured: true,
  },
  {
    title: 'Gartenpflege',
    text: 'Regelmäßig oder einmalig – Rasenpflege, Hecken- und Baumschnitt, Beetpflege und Laubentfernung über die ganze Saison.',
    image: '/images/leistung-pflege.jpg',
    tags: ['Rasen & Hecken', 'Baumschnitt', 'Pflegevertrag'],
    featured: true,
  },
  {
    title: 'Fassadenreinigung',
    text: 'Schonende Entfernung von Algen, Moos und Grauschleier – Ihre Fassade sieht wieder aus wie am ersten Tag.',
    image: '/images/leistung-fassade.jpg',
    tags: ['Algen & Moos', 'Sanftstrahl'],
    featured: false,
  },
];

const benefits = [
  {
    icon: '🌿',
    title: 'Alles aus einer Hand',
    text: 'Garten, Grünpflege und Fassade – ein Ansprechpartner statt drei Firmen und drei Terminen.',
  },
  {
    icon: '🛠️',
    title: 'Saubere Ausführung',
    text: 'Fachgerechte Arbeit und Materialien, die auch in zehn Jahren noch überzeugen.',
  },
  {
    icon: '💬',
    title: 'Fester Ansprechpartner',
    text: 'Sie erreichen uns direkt – ohne Callcenter, ohne Warteschleife, mit Antwort innerhalb von 12 Stunden.',
  },
  {
    icon: '📄',
    title: 'Fest- oder Pauschalpreis',
    text: 'Sie entscheiden: fester Preis für das einzelne Projekt oder Pauschale für die laufende Pflege. Transparent vor Beginn.',
  },
  {
    icon: '🧹',
    title: 'Saubere Baustelle',
    text: 'Wir hinterlassen Ihr Grundstück besenrein und übernehmen die fachgerechte Entsorgung des Grünschnitts.',
  },
  {
    icon: '📅',
    title: 'Termintreue',
    text: 'Zugesagte Termine halten wir. Bei Wetterverzögerungen melden wir uns aktiv bei Ihnen – nicht umgekehrt.',
  },
];

const steps = [
  {
    number: '01',
    title: 'Anfrage stellen',
    text: 'Sie schildern uns kurz Ihr Vorhaben – telefonisch oder über das Kontaktformular. Das dauert keine drei Minuten.',
  },
  {
    number: '02',
    title: 'Termin & Angebot vor Ort',
    text: 'Wir schauen uns Ihren Außenbereich in Ruhe an, beraten Sie ehrlich und erstellen ein verbindliches Angebot – als Festpreis oder Pauschale.',
  },
  {
    number: '03',
    title: 'Umsetzung & Übergabe',
    text: 'Zum vereinbarten Termin legen wir los. Am Ende übergeben wir sauber – auf Wunsch mit passendem Pflegevertrag.',
  },
];

const projects = [
  {
    image: '/images/projekt-1.jpg',
    title: 'Formschnitt & Heckenpflege',
    text: 'Jährliche Pflege einer 120 m langen Buchsbaumanlage',
  },
  {
    image: '/images/projekt-2.jpg',
    title: 'Terrasse aus Naturstein',
    text: 'Neuanlage inkl. Unterbau, Entwässerung und Rollrasen',
  },
  {
    image: '/images/projekt-3.jpg',
    title: 'Staudenbeete & Bepflanzung',
    text: 'Blühkonzept über drei Jahreszeiten für einen Privatgarten',
  },
];

// Echte Google-Bewertungen hier eintragen. Solange die Liste leer ist,
// wird der gesamte Kundenstimmen-Abschnitt nicht angezeigt.
// Aufbau pro Eintrag:
//   { quote: 'Text der Bewertung', name: 'Vorname N.', role: 'Google-Bewertung', stars: 5 }
const testimonials: {
  quote: string;
  name: string;
  role: string;
  stars: number;
}[] = [];

const faqs = [
  {
    q: 'Kostet die Beratung vor Ort etwas?',
    a: 'Nein. Der Vor-Ort-Termin, die Beratung und das anschließende Angebot sind für Sie komplett kostenlos und unverbindlich.',
  },
  {
    q: 'In welchem Umkreis arbeiten Sie?',
    a: 'Wir sind in Weinheim und Umgebung für Sie unterwegs. Bei größeren Projekten kommen wir auf Anfrage auch weiter – sprechen Sie uns einfach an.',
  },
  {
    q: 'Übernehmen Sie auch die Entsorgung des Grünschnitts?',
    a: 'Ja. Grünschnitt, Aushub und Bauschutt entsorgen wir fachgerecht. Die Kosten dafür sind im Angebot bereits enthalten – es kommt nichts nach.',
  },
  {
    q: 'Bieten Sie Gartenpflege auch im Abo an?',
    a: 'Ja. Im Pflegevertrag legen wir gemeinsam Umfang und Rhythmus fest – zum Beispiel 14-tägig in der Saison. Sie bekommen einen festen Monatspreis und feste Termine.',
  },
  {
    q: 'Wie schnell bekomme ich einen Termin?',
    a: 'Beratungstermine vergeben wir in der Regel innerhalb einer Woche. Reinigungsaufträge setzen wir meist innerhalb von 14 Tagen um, größere Bauprojekte nach Absprache.',
  },
];
---

<BaseLayout
  title="EA-Außenpflege | Garten- & Landschaftsbau, Gartenpflege und Reinigung"
  description="EA-Außenpflege ist Ihr Partner für Garten- und Landschaftsbau, Gartenpflege sowie Fassadenreinigung in Weinheim und Umgebung. Jetzt kostenloses Angebot anfordern."
>
  <!-- ============================ HERO ============================ -->
  <section class="hero">
    <div class="hero__bg">
      <img
        src="/images/hero.jpg"
        alt="Gepflegter Garten mit frisch gemähtem Rasen"
        width="1600"
        height="900"
        fetchpriority="high"
      />
    </div>

    <div class="container hero__inner">
      <p class="hero__eyebrow animate-in" style="--delay: 60ms">
        <span aria-hidden="true">🌱</span> Garten- &amp; Außenpflege in Weinheim und Umgebung
      </p>

      <h1 class="animate-in" style="--delay: 160ms">
        Ihr Außenbereich.<br />
        <em>Gepflegt, gestaltet, gemacht.</em>
      </h1>

      <p class="hero__text animate-in" style="--delay: 260ms">
        Garten- und Landschaftsbau, regelmäßige Pflege und die professionelle Reinigung von
        Fassaden – alles von einem Team, das anpackt und mitdenkt.
      </p>

      <div class="btn-row animate-in" style="--delay: 360ms">
        <a class="btn btn--primary" href="/kontakt">
          Kostenloses Angebot anfordern <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn--ghost-light" href="#leistungen">Leistungen ansehen</a>
      </div>

      <ul class="hero__facts animate-in" style="--delay: 460ms">
        <li>Kostenlose Beratung vor Ort</li>
        <li>Fest- &amp; Pauschalpreise</li>
        <li>Antwort in 12 Stunden</li>
      </ul>
    </div>
  </section>

  <!-- ========================== TRUSTBAR ========================== -->
  <section class="trustbar" aria-label="Partner und Zertifizierungen">
    <div class="container">
      <p class="trustbar__label">Partner, Lieferanten &amp; Zertifizierungen</p>
    </div>

    <div class="marquee">
      <div class="marquee__track">
        {
          [0, 1].map((pass) =>
            partners.map((partner) => (
              <img
                class="marquee__logo"
                src={partner.src}
                alt={pass === 0 ? partner.alt : ''}
                aria-hidden={pass === 1 ? 'true' : undefined}
                width="220"
                height="60"
                loading="lazy"
              />
            )),
          )
        }
      </div>
    </div>
  </section>

  <!-- ======================= EIN-ZEILEN-SEKTION ==================== -->
  <section class="statement section">
    <div class="container">
      <p data-reveal>
        <strong>EA-Außenpflege</strong> ist Ihr Partner für Garten- und Landschaftsbau –
        für <span class="hl">Privatgärten</span>, <span class="hl">Hausverwaltungen</span> und
        <span class="hl">Gewerbeobjekte</span> in Weinheim und Umgebung.
      </p>
    </div>
  </section>

  <!-- ========================= LEISTUNGEN ========================= -->
  <section class="section section--tint" id="leistungen">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Unsere Leistungen</span>
        <h2>Drei Leistungen, ein Ansprechpartner</h2>
        <p>
          Der Schwerpunkt liegt im Garten- und Landschaftsbau. Rundum sauber wird es mit unseren
          ergänzenden Reinigungsleistungen.
        </p>
      </div>

      <div class="services">
        {
          services.map((service, index) => (
            <article
              class:list={['service', { 'service--featured': service.featured }]}
              data-reveal
              style={`--reveal-delay: ${index * 90}ms`}
            >
              <div class="service__media">
                <img
                  src={service.image}
                  alt={service.title}
                  width="800"
                  height="600"
                  loading="lazy"
                />
              </div>

              <div class="service__body">
                {service.featured && <span class="service__badge">Kerngeschäft</span>}
                <h3>{service.title}</h3>
                <p>{service.text}</p>
                <ul class="chips">
                  {service.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
                <a class="link-arrow" href="/dienstleistungen">
                  Mehr erfahren <span class="arrow" aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ========================== VORTEILE ========================== -->
  <section class="section" id="vorteile">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Warum EA-Außenpflege</span>
        <h2>Damit Sie sich um nichts kümmern müssen</h2>
        <p>Sechs Gründe, warum unsere Kunden immer wieder bei uns anrufen.</p>
      </div>

      <div class="benefits">
        {
          benefits.map((benefit, index) => (
            <article class="card benefit" data-reveal style={`--reveal-delay: ${index * 70}ms`}>
              <span class="benefit__icon" aria-hidden="true">
                {benefit.icon}
              </span>
              <h3>{benefit.title}</h3>
              <p>{benefit.text}</p>
            </article>
          ))
        }
      </div>

      <div class="stats" data-reveal>
        <div class="stat">
          <span class="stat__value"><span data-count="3">0</span></span>
          <span class="stat__label">Jahre Erfahrung</span>
        </div>
        <div class="stat">
          <span class="stat__value"><span data-count="12">0</span>h</span>
          <span class="stat__label">Antwortzeit</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================= CTA-BAND (1) ========================= -->
  <section class="cta-band">
    <div class="container cta-band__inner" data-reveal>
      <div>
        <h2>Neugierig, was aus Ihrem Garten werden kann?</h2>
        <p>Wir schauen vorbei, beraten Sie ehrlich und rechnen Ihnen dafür keinen Cent an.</p>
      </div>
      <a class="btn btn--primary" href="/kontakt">
        Kostenloses Angebot anfordern <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <!-- ===================== SO FUNKTIONIERT ES ===================== -->
  <section class="section" id="ablauf">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">So funktioniert es</span>
        <h2>In drei Schritten zum fertigen Außenbereich</h2>
        <p>Kein Papierkrieg, keine Warteschleifen – so einfach läuft die Zusammenarbeit ab.</p>
      </div>

      <ol class="steps">
        {
          steps.map((step, index) => (
            <li class="step" data-reveal style={`--reveal-delay: ${index * 120}ms`}>
              <span class="step__number">{step.number}</span>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>

      <div class="center-cta" data-reveal>
        <a class="btn btn--green" href="/kontakt">
          Jetzt Schritt 1 starten <span class="arrow" aria-hidden="true">→</span>
        </a>
        <p class="center-cta__note">Unverbindlich – und in unter drei Minuten erledigt.</p>
      </div>
    </div>
  </section>

  <!-- ========================== PROJEKTE ========================== -->
  <section class="section section--tint" id="projekte">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Referenzen</span>
        <h2>Ausschnitte aus unserer Arbeit</h2>
        <p>Ein paar Projekte, die zeigen, was aus einem Außenbereich werden kann.</p>
      </div>

      <div class="projects">
        {
          projects.map((project, index) => (
            <figure class="project" data-reveal="zoom" style={`--reveal-delay: ${index * 100}ms`}>
              <img
                src={project.image}
                alt={project.title}
                width="800"
                height="600"
                loading="lazy"
              />
              <figcaption>
                <strong>{project.title}</strong>
                <span>{project.text}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- =========================== ÜBER UNS ========================= -->
  <section class="section about" id="ueber-uns">
    <div class="container about__grid">
      <div class="about__media" data-reveal="left">
        <img
          src="/images/team.jpg"
          alt="Mitarbeiter von EA-Außenpflege bei der Rasenpflege"
          width="900"
          height="900"
          loading="lazy"
        />
        <div class="about__badge">
          <strong>seit 2023</strong>
          <span>im Familienbetrieb</span>
        </div>
      </div>

      <div class="about__text" data-reveal="right">
        <span class="eyebrow">Über uns</span>
        <h2>Ein Betrieb, der beim Wort genommen werden will</h2>
        <p class="lead">
          EA-Außenpflege ist ein inhabergeführter Familienbetrieb aus Weinheim. Angefangen mit
          einem Anhänger und viel Freude an der Arbeit im Grünen, sind wir heute ein eingespieltes
          Team für alles rund um Haus und Garten.
        </p>
        <p>
          Was uns wichtig ist: ehrliche Beratung, saubere Arbeit und Termine, die halten. Deshalb
          nehmen wir nur so viele Projekte an, wie wir auch wirklich gut betreuen können – und
          bleiben für unsere Kunden über Jahre der feste Ansprechpartner für den gesamten
          Außenbereich.
        </p>
        <a class="link-arrow" href="/ueber-mich">
          Mehr über uns erfahren <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ======================== TESTIMONIALS ======================== -->
  {
    testimonials.length > 0 && (
      <section class="section section--soft" id="stimmen">
        <div class="container">
          <div class="section-head" data-reveal>
            <span class="eyebrow">Kundenstimmen</span>
            <h2>Was unsere Kunden sagen</h2>
            <p>Bewertungen unserer Kundinnen und Kunden bei Google.</p>
          </div>

          <div class="testimonials">
            {testimonials.map((testimonial, index) => (
              <figure class="testimonial" data-reveal style={`--reveal-delay: ${index * 100}ms`}>
                <div
                  class="testimonial__stars"
                  aria-label={`${testimonial.stars} von 5 Sternen`}
                >
                  {'★'.repeat(testimonial.stars)}
                </div>
                <blockquote>{testimonial.quote}</blockquote>
                <figcaption>
                  <span>
                    <strong>{testimonial.name}</strong>
                    <small>{testimonial.role}</small>
                  </span>
                </figcaption>
              </figure>
            ))}
          </div>

          <div class="center-cta" data-reveal>
            <a class="btn btn--primary" href="/kontakt">
              Kostenloses Angebot anfordern <span class="arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </section>
    )
  }

  <!-- ============================= FAQ ============================ -->
  <section class="section" id="faq">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="eyebrow">Häufige Fragen</span>
        <h2>Gut zu wissen</h2>
        <p>Und wenn Ihre Frage nicht dabei ist: einfach anrufen, wir sind erreichbar.</p>
      </div>

      <div class="faq">
        {
          faqs.map((faq, index) => (
            <details class="faq__item" data-reveal style={`--reveal-delay: ${index * 60}ms`}>
              <summary>
                {faq.q}
                <span class="faq__icon" aria-hidden="true" />
              </summary>
              <div class="faq__answer">
                <p>{faq.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ========================= BOTTOM CTA ========================= -->
  <section class="final-cta">
    <div class="final-cta__bg">
      <img src="/images/cta-bg.jpg" alt="" width="1600" height="700" loading="lazy" />
    </div>

    <div class="container final-cta__inner" data-reveal>
      <span class="eyebrow eyebrow--light">Kostenlos &amp; unverbindlich</span>
      <h2>Lassen Sie uns über Ihren Außenbereich sprechen</h2>
      <p>
        Erzählen Sie uns kurz, worum es geht. Wir melden uns innerhalb von 12 Stunden mit einem
        Terminvorschlag – und kommen für die Beratung persönlich vorbei.
      </p>

      <div class="btn-row final-cta__actions">
        <a class="btn btn--primary" href="/kontakt">
          Kostenloses Angebot anfordern <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn--ghost-light" href="tel:+4917621190179">Oder anrufen: 0176 21190179</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ============================ HERO ============================ */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: clamp(560px, 88vh, 860px);
    padding-block: clamp(4rem, 10vw, 7rem);
    color: #fff;
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: hero-zoom 16s var(--ease) forwards;
  }

  .hero__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        100deg,
        rgba(30, 61, 43, 0.93) 0%,
        rgba(30, 61, 43, 0.74) 45%,
        rgba(30, 61, 43, 0.32) 100%
      ),
      linear-gradient(180deg, rgba(30, 61, 43, 0.35) 0%, rgba(30, 61, 43, 0.1) 40%);
  }

  @keyframes hero-zoom {
    from {
      transform: scale(1.12);
    }
    to {
      transform: scale(1);
    }
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    max-width: 940px;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 1.05rem;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.28);
    backdrop-filter: blur(8px);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .hero h1 {
    margin-top: 1.5rem;
    font-size: var(--fs-hero);
    color: #fff;
    max-width: 16ch;
  }

  .hero h1 em {
    font-style: normal;
    color: var(--accent);
  }

  .hero__text {
    margin-top: 1.4rem;
    max-width: 56ch;
    font-size: var(--fs-lead);
    color: rgba(255, 255, 255, 0.9);
  }

  .hero .btn-row {
    margin-top: 2.2rem;
  }

  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 2rem;
    list-style: none;
    padding: 0;
    margin-top: 2.6rem;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.88);
  }

  .hero__facts li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .hero__facts li::before {
    content: '✓';
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--green);
    color: #fff;
    font-size: 0.72rem;
    font-weight: 700;
    flex: none;
  }

  /* ========================== TRUSTBAR ========================== */
  .trustbar {
    padding-block: clamp(2.25rem, 4vw, 3.25rem);
    border-bottom: 1px solid var(--line);
    background: var(--white);
  }

  .trustbar__label {
    text-align: center;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: 1.6rem;
  }

  .marquee {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }

  .marquee__track {
    display: flex;
    align-items: center;
    gap: clamp(2.5rem, 6vw, 5rem);
    width: max-content;
    padding-inline: clamp(1.25rem, 3vw, 2.5rem);
    animation: marquee 34s linear infinite;
  }

  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }

  .marquee__logo {
    height: 46px;
    width: auto;
    opacity: 0.5;
    filter: grayscale(1);
    transition:
      opacity 0.35s ease,
      filter 0.35s ease,
      transform 0.35s var(--ease);
  }

  .marquee__logo:hover {
    opacity: 1;
    filter: none;
    transform: translateY(-3px);
  }

  /* ====================== EIN-ZEILEN-SEKTION ==================== */
  .statement {
    text-align: center;
  }

  .statement p {
    max-width: 30ch;
    margin-inline: auto;
    font-size: clamp(1.4rem, 0.9rem + 2vw, 2.35rem);
    line-height: 1.35;
    font-weight: 600;
    color: var(--green-dark);
    letter-spacing: -0.02em;
  }

  .statement .hl {
    white-space: nowrap;
    color: var(--green-700);
    background: linear-gradient(
      to top,
      rgba(92, 184, 92, 0.26) 0 0.3em,
      transparent 0.3em
    );
    padding-inline: 0.08em;
  }

  /* ========================= LEISTUNGEN ========================= */
