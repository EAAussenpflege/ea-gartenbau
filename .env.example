# Vorlage für die FTP-Zugangsdaten.
#
# 1. Diese Datei kopieren und die Kopie in ".env" umbenennen
# 2. Werte aus dem STRATO-Kundenlogin eintragen
#
# Die Datei .env ist über .gitignore ausgeschlossen und landet nie auf GitHub.

FTP_SERVER=ftp.strato.de
FTP_USERNAME=
FTP_PASSWORD=

# Zielverzeichnis auf dem Webspace.
# "/" = Wurzelverzeichnis direkt nach dem FTP-Login.
# Liegt die Domain in einem Unterordner, z. B. /ea-gartenbau.de
FTP_DIR=/

# Verschlüsselung:
#   true    = Anmeldung und Dateien verschlüsselt (empfohlen)
#   control = Anmeldung verschlüsselt, Dateien im Klartext
#             (nötig, wenn der Server mit "504" antwortet)
#   false   = gar keine Verschlüsselung
FTP_SECURE=true

# Auf true setzen, um den kompletten FTP-Dialog zur Fehlersuche auszugeben.
FTP_DEBUG=false
